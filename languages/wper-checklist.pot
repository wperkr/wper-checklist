#: data/js-vulns.php:26
msgid "CVE-2013-4383 family"
msgstr ""

#: data/js-vulns.php:51
msgid "CVE-2024-6783 family"
msgstr ""

#: data/recommendations.php:16
msgid "The landing page is likely executing PHP and DB queries on every request — there is no page cache (e.g. nginx FastCGI) or its miss rate is high."
msgstr ""

#: data/recommendations.php:17
msgid "Enable a server-layer page cache (nginx FastCGI cache) together with an object cache (Redis) and OPcache. Avoid stacking cache plugins."
msgstr ""

#: data/recommendations.php:20
msgid "Archive listing queries are heavy and slow down easily without caching."
msgstr ""

#: data/recommendations.php:21
msgid "Include archives in the page cache scope and verify listing queries use indexes."
msgstr ""

#: data/recommendations.php:24
msgid "Post rendering is uncached, or related-post/widget queries are heavy."
msgstr ""

#: data/recommendations.php:25
msgid "Apply page caching and audit the query cost of related-post plugins and sidebar widgets."
msgstr ""

#: data/recommendations.php:28
msgid "Static pages are rendered on every request without caching."
msgstr ""

#: data/recommendations.php:29
msgid "Check the page cache coverage."
msgstr ""

#: data/recommendations.php:32
msgid "Product/service pages tend to be excluded from caching due to dynamic elements."
msgstr ""

#: data/recommendations.php:33
msgid "Exclude only personalized fragments (cart etc.) and cache the rest."
msgstr ""

#: data/recommendations.php:36
msgid "Measurements vary widely — fluctuating server load, cache-miss mixing, or resource contention is suspected."
msgstr ""

#: data/recommendations.php:37
msgid "Re-measure during low traffic; if the spread persists, inspect server resources (CPU/memory) and co-hosted workloads."
msgstr ""

#: data/recommendations.php:40
msgid "The HTML payload is large — excessive inline CSS/JS or page-builder markup bloat are the usual causes."
msgstr ""

#: data/recommendations.php:41
msgid "Move unnecessary inline assets to external files and verify gzip/brotli compression."
msgstr ""

#: data/recommendations.php:44
msgid "Every redirect hop adds a round trip and increases perceived latency."
msgstr ""

#: data/recommendations.php:45
msgid "Point internal links and canonicals at the final URL (www vs non-www, trailing slash)."
msgstr ""

#: data/recommendations.php:50
msgid "Too many queries for one landing view — widget, menu, and option lookups are likely repeating uncached."
msgstr ""

#: data/recommendations.php:51
msgid "Introduce a Redis object cache and use Query Monitor to find and reduce hotspots."
msgstr ""

#: data/recommendations.php:54
msgid "Post pages issue many queries — related-post, view-counter, and comment plugins are common causes."
msgstr ""

#: data/recommendations.php:55
msgid "Attribute queries per plugin and wrap cacheable lookups in transients."
msgstr ""

#: data/recommendations.php:58
msgid "The archive loop may run extra queries per post (N+1)."
msgstr ""

#: data/recommendations.php:59
msgid "Check update_post_meta_cache / update_post_term_cache and per-item lookups inside the loop."
msgstr ""

#: data/recommendations.php:62
msgid "DB time is high — slow queries or latency on the DB server itself."
msgstr ""

#: data/recommendations.php:63
msgid "Enable the slow query log to pinpoint offenders, then tune indexes and buffer pool size."
msgstr ""

#: data/recommendations.php:66
msgid "Queries exceed 20ms — index misses or full scans on large tables are suspected."
msgstr ""

#: data/recommendations.php:67
msgid "Inspect the plan with EXPLAIN and add the missing indexes."
msgstr ""

#: data/recommendations.php:70
msgid "Identically-shaped queries repeat within one request — per-item lookups inside a loop (N+1)."
msgstr ""

#: data/recommendations.php:71
msgid "Batch the repeated lookups or absorb them with the object cache."
msgstr ""

#: data/recommendations.php:74
msgid "Without an external object cache, repeated queries hit the DB every time."
msgstr ""

#: data/recommendations.php:75
msgid "Run a Redis server and enable the drop-in via the redis-cache plugin (wp redis enable)."
msgstr ""

#: data/recommendations.php:80
msgid "The document title is missing or outside the recommended 10–60 characters — search results truncate or ignore it."
msgstr ""

#: data/recommendations.php:81
msgid "Configure title templates in your SEO plugin (e.g. Rank Math)."
msgstr ""

#: data/recommendations.php:84
msgid "Without a meta description, search engines excerpt arbitrarily — you lose control of the click-through pitch."
msgstr ""

#: data/recommendations.php:85
msgid "Write 50–160 character summaries yourself, starting with key pages."
msgstr ""

#: data/recommendations.php:88
msgid "A missing or duplicated H1 blurs the page topic signal."
msgstr ""

#: data/recommendations.php:89
msgid "Keep one H1 per page and demote the rest to H2 and below."
msgstr ""

#: data/recommendations.php:92
msgid "The landing page is blocked by noindex or robots.txt — it cannot appear in search at all."
msgstr ""

#: data/recommendations.php:93
msgid "If unintended, check Settings › Reading discourage-search option and your SEO plugin robots settings."
msgstr ""

#: data/recommendations.php:96
msgid "A missing or off-target canonical causes duplicate-content judgments and diluted authority."
msgstr ""

#: data/recommendations.php:97
msgid "Verify your SEO plugin outputs a self-referential canonical."
msgstr ""

#: data/recommendations.php:100
msgid "Without html lang, search engines and screen readers must guess the language."
msgstr ""

#: data/recommendations.php:101
msgid "Check the theme outputs <html <?php language_attributes(); ?>>."
msgstr ""

#: data/recommendations.php:104
msgid "Without a viewport meta the desktop layout renders shrunken on mobile — failing mobile-friendliness."
msgstr ""

#: data/recommendations.php:105
msgid "Add the standard viewport meta to the theme head."
msgstr ""

#: data/recommendations.php:108
msgid "Images without alt are excluded from image search and cost accessibility points."
msgstr ""

#: data/recommendations.php:109
msgid "Fill in alt text starting with meaningful images in the media library. Decorative images should carry an empty alt=\"\"."
msgstr ""

#: data/recommendations.php:112
msgid "Links without text tell crawlers and screen readers nothing about the destination."
msgstr ""

#: data/recommendations.php:113
msgid "Give icon links an aria-label or visually hidden text."
msgstr ""

#: data/recommendations.php:116
msgid "Without structured data the site is excluded from rich results (FAQ, ratings, breadcrumbs)."
msgstr ""

#: data/recommendations.php:117
msgid "Enable your SEO plugin schema features and emit Article, FAQPage, BreadcrumbList."
msgstr ""

#: data/recommendations.php:120
msgid "If you have multilingual pages without hreflang, the wrong language version may surface."
msgstr ""

#: data/recommendations.php:121
msgid "No action needed for single-language sites. For multilingual sites, declare reciprocal alternates plus x-default."
msgstr ""

#: data/recommendations.php:124
msgid "Without OG meta, shares on social media pick arbitrary titles and images."
msgstr ""

#: data/recommendations.php:125
msgid "Enable social meta output in your SEO plugin and set a default image."
msgstr ""

#: data/recommendations.php:128
msgid "An http site — or https pages referencing http assets — triggers browser warnings and ranking penalties."
msgstr ""

#: data/recommendations.php:129
msgid "Install a TLS certificate and bulk-replace http:// references in the DB (wp search-replace)."
msgstr ""

#: data/recommendations.php:132
msgid "A missing sitemap (or one absent from robots.txt) slows discovery of new content."
msgstr ""

#: data/recommendations.php:133
msgid "Enable the SEO plugin sitemap, add a Sitemap: line to robots.txt, and submit it to Search Console."
msgstr ""

#: data/recommendations.php:138
msgid "Your core version has published vulnerabilities — public CVEs are the first target of automated scanners."
msgstr ""

#: data/recommendations.php:139
msgid "Update core immediately after staging verification. Mitigate with WAF rules until then."
msgstr ""

#: data/recommendations.php:142
msgid "Core is outdated — the version is public, making known flaws targetable."
msgstr ""

#: data/recommendations.php:143
msgid "Back up, then update to the latest version."
msgstr ""

#: data/recommendations.php:146
msgid "A plugin with known vulnerabilities is active — the most common WordPress breach entry point."
msgstr ""

#: data/recommendations.php:147
msgid "Update it immediately; if no fixed release exists, deactivate and find a replacement."
msgstr ""

#: data/recommendations.php:150
msgid "For outdated plugins, the published changelog doubles as an attack manual."
msgstr ""

#: data/recommendations.php:151
msgid "Establish a recurring update routine: verify on staging, then roll to production."
msgstr ""

#: data/recommendations.php:154
msgid "The theme has known vulnerabilities."
msgstr ""

#: data/recommendations.php:155
msgid "Update the theme, or if it is abandoned, consider switching to a maintained one."
msgstr ""

#: data/recommendations.php:158
msgid "Theme updates are pending."
msgstr ""

#: data/recommendations.php:159
msgid "Keeping customizations in a child theme lets you update the parent safely."
msgstr ""

#: data/recommendations.php:162
msgid "A front-end JS library with known vulnerabilities (XSS etc.) is being loaded."
msgstr ""

#: data/recommendations.php:163
msgid "Update the theme/plugin loading it. Core-bundled jQuery is fixed by updating core."
msgstr ""

#: data/recommendations.php:166
msgid "?author=N redirects hand out login usernames — giving attackers half of a brute-force pair for free."
msgstr ""

#: data/recommendations.php:167
msgid "Block author-scan redirects at the web server or via security configuration."
msgstr ""

#: data/recommendations.php:170
msgid "xmlrpc.php enables amplified login attempts (system.multicall) and pingback DDoS."
msgstr ""

#: data/recommendations.php:171
msgid "If no app depends on it, block xmlrpc.php at the web server."
msgstr ""

#: data/recommendations.php:174
msgid "The REST users endpoint is open to unauthenticated requests, enumerating login names."
msgstr ""

#: data/recommendations.php:175
msgid "Block unauthenticated /wp-json/wp/v2/users at the web server or require authentication."
msgstr ""

#: data/recommendations.php:180
msgid "PHP past (or near) end of security support receives no fixes for new vulnerabilities."
msgstr ""

#: data/recommendations.php:181
msgid "Upgrade to a supported PHP branch. Verify compatibility on staging first."
msgstr ""

#: data/recommendations.php:184
msgid "X-Powered-By exposes the PHP version, inviting version-specific attacks."
msgstr ""

#: data/recommendations.php:185
msgid "Set expose_php = Off in php.ini."
msgstr ""

#: data/recommendations.php:188
msgid "With shell-execution functions open, one code injection becomes full server takeover."
msgstr ""

#: data/recommendations.php:189
msgid "Add exec, shell_exec, system, passthru, proc_open, popen to disable_functions in php.ini."
msgstr ""

#: data/recommendations.php:192
msgid "Disabling curl_exec kills all WordPress outbound HTTP (core updates, plugin installs, external APIs) — the classic copy-pasted-blocklist accident."
msgstr ""

#: data/recommendations.php:193
msgid "Remove curl_exec from disable_functions."
msgstr ""

#: data/recommendations.php:196
msgid "With allow_url_fopen on, file functions can open remote URLs, widening the remote-inclusion attack surface."
msgstr ""

#: data/recommendations.php:197
msgid "Set allow_url_fopen = Off in php.ini. WordPress uses cURL, so nothing breaks."
msgstr ""

#: data/recommendations.php:200
msgid "Error messages shown to visitors leak paths, queries, and internal structure."
msgstr ""

#: data/recommendations.php:201
msgid "Set display_errors = Off and keep log_errors writing to a file instead."
msgstr ""

#: data/recommendations.php:204
msgid "Without a path restriction, compromised PHP can reach files across the whole server."
msgstr ""

#: data/recommendations.php:205
msgid "Restrict open_basedir to the document root plus the temp directory."
msgstr ""

#: data/recommendations.php:208
msgid "WP_DEBUG in production can expose errors to visitors."
msgstr ""

#: data/recommendations.php:209
msgid "Keep WP_DEBUG false; if you need logs, enable only WP_DEBUG_LOG and keep WP_DEBUG_DISPLAY always false."
msgstr ""

#: data/recommendations.php:212
msgid "The built-in theme/plugin editor is the shortest path to a web shell once an admin account is stolen."
msgstr ""

#: data/recommendations.php:213
msgid "Add define( 'DISALLOW_FILE_EDIT', true ) to wp-config.php."
msgstr ""

#: data/recommendations.php:216
msgid "utf8 (3-byte) silently loses emoji and some CJK characters."
msgstr ""

#: data/recommendations.php:217
msgid "Switch DB_CHARSET to utf8mb4 and convert existing tables (back up first)."
msgstr ""

#: data/recommendations.php:220
msgid "Without security headers, MIME-sniffing, clickjacking, and referrer-leak defenses rely on browser defaults alone."
msgstr ""

#: data/recommendations.php:221
msgid "Add X-Content-Type-Options, X-Frame-Options, Referrer-Policy, Permissions-Policy, and (on https) HSTS at the web server."
msgstr ""

#: data/recommendations.php:224
msgid "Exposed server software versions invite attacks on version-specific known flaws."
msgstr ""

#: data/recommendations.php:225
msgid "Hide versions with server_tokens off (nginx) and expose_php Off (PHP)."
msgstr ""

#: data/recommendations.php:228
msgid "Without forced https, session cookies can travel in plaintext."
msgstr ""

#: data/recommendations.php:229
msgid "Add an http→https 301 redirect at the web server and define( 'FORCE_SSL_ADMIN', true ) in wp-config.php."
msgstr ""

#: data/recommendations.php:232
msgid "Web-reachable config files, repository metadata, or PHP execution inside uploads leads straight to disclosure and remote execution."
msgstr ""

#: data/recommendations.php:233
msgid "Block access to wp-config.php, .git, and *.sql at the web server and forbid PHP execution in uploads."
msgstr ""

#: data/recommendations.php:236
msgid "The DB server is outdated or deviates from recommended settings (utf8mb4, local_infile Off, slow query log)."
msgstr ""

#: data/recommendations.php:237
msgid "Upgrade to a supported MariaDB/MySQL and set character-set-server=utf8mb4, local_infile=0, slow_query_log=1 in my.cnf."
msgstr ""

